{
  "uid": "mule-jvm",
  "title": "Mule JVM",
  "tags": [
    "mule",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "JVM of every Mule worker, pushed by otel-mule4-agent to Prometheus (OTLP). App = the app's name (label job); Worker lists the workers running the chosen apps. One line per worker: apps sharing a worker report the same JVM.",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": null,
        "query": {
          "query": "label_values(jvm_memory_used_bytes, job)",
          "refId": "app"
        },
        "definition": "label_values(jvm_memory_used_bytes, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": null,
        "query": {
          "query": "label_values(jvm_memory_used_bytes{job=~\"$app\"}, worker_id)",
          "refId": "worker"
        },
        "definition": "label_values(jvm_memory_used_bytes{job=~\"$app\"}, worker_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Shared workers",
      "description": "Workers of the chosen apps that also run other apps. Their heap, CPU and GC belong to all apps on them, not to one app. 0 = every chosen app has dedicated workers (CloudHub style: one pool per app).",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((count by (worker_id) (count by (worker_id, job) (jvm_memory_used_bytes{worker_id=~\"$worker\"})) > 1) and on (worker_id) count by (worker_id) (jvm_memory_used_bytes{job=~\"$app\", worker_id=~\"$worker\"})) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Workers of the chosen apps",
      "description": "Apps on worker > 1: the JVM numbers below are shared by those apps.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (worker_id) (count by (worker_id, job) (jvm_memory_used_bytes{worker_id=~\"$worker\"})) and on (worker_id) count by (worker_id) (jvm_memory_used_bytes{job=~\"$app\", worker_id=~\"$worker\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "worker_id": "Worker",
              "Value": "Apps on worker"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Apps on worker"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Apps on those workers",
      "description": "Every app deployed on a worker of the chosen apps, including apps outside the App filter.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (worker_id, job) (jvm_memory_used_bytes{worker_id=~\"$worker\"}) and on (worker_id) count by (worker_id) (jvm_memory_used_bytes{job=~\"$app\", worker_id=~\"$worker\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "worker_id": "Worker",
              "job": "App",
              "Value": "series"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Heap used / limit",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (sum by (worker_id, job) (jvm_memory_used_bytes{jvm_memory_type=\"heap\", job=~\"$app\", worker_id=~\"$worker\"}))",
          "legendFormat": "{{worker_id}} used"
        },
        {
          "refId": "B",
          "expr": "max by (worker_id) (sum by (worker_id, job) (jvm_memory_limit_bytes{jvm_memory_type=\"heap\", job=~\"$app\", worker_id=~\"$worker\"}))",
          "legendFormat": "{{worker_id}} limit"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Non-heap used (metaspace, code cache)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (sum by (worker_id, job) (jvm_memory_used_bytes{jvm_memory_type=\"non_heap\", job=~\"$app\", worker_id=~\"$worker\"}))",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC time per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (sum by (worker_id, job) (rate(jvm_gc_duration_seconds_sum{job=~\"$app\", worker_id=~\"$worker\"}[$__rate_interval])))",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (jvm_cpu_recent_utilization_ratio{job=~\"$app\", worker_id=~\"$worker\"})",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Threads",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (sum by (worker_id, job) (jvm_thread_count{job=~\"$app\", worker_id=~\"$worker\"}))",
          "legendFormat": "{{worker_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Classes loaded",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker_id) (sum by (worker_id, job) (jvm_class_count{job=~\"$app\", worker_id=~\"$worker\"}))",
          "legendFormat": "{{worker_id}}"
        }
      ]
    }
  ]
}
