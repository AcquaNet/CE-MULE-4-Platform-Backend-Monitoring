{
  "realm": "mule",
  "enabled": true,
  "displayName": "Mule Platform",
  "displayNameHtml": "<strong>Mule Platform</strong>",
  "loginTheme": "keycloak",
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    {
      "name": "tenants",
      "subGroups": [
        {
          "name": "tenant-default",
          "attributes": {
            "tenant_id": [
              "default"
            ]
          }
        },
        {
          "name": "tenant-demo",
          "attributes": {
            "tenant_id": [
              "demo"
            ]
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@mule.local",
      "firstName": "Admin",
      "lastName": "User",
      "attributes": {
        "tenant_id": [
          "default"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_REALM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mule",
        "user",
        "admin"
      ],
      "clientRoles": {
        "mule-api-gateway": [
          "api-access"
        ],
        "dashboards": [
          "dashboards-user"
        ],
        "realm-management": [
          "realm-admin"
        ]
      },
      "groups": [
        "/tenants/tenant-default"
      ]
    },
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@mule.local",
      "firstName": "Developer",
      "lastName": "User",
      "attributes": {
        "tenant_id": [
          "demo"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_REALM_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-mule",
        "user"
      ],
      "clientRoles": {
        "mule-api-gateway": [
          "api-access"
        ],
        "dashboards": [
          "dashboards-user"
        ]
      },
      "groups": [
        "/tenants/tenant-demo"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "User role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "dashboards-admin",
        "description": "OpenSearch Dashboards administrator role"
      }
    ],
    "client": {
      "mule-api-gateway": [
        {
          "name": "api-access",
          "description": "API access role"
        }
      ],
      "dashboards": [
        {
          "name": "dashboards-user",
          "description": "OpenSearch Dashboards user role for log viewing"
        },
        {
          "name": "dashboards-admin",
          "description": "OpenSearch Dashboards admin role"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "mule-api-gateway",
      "name": "Mule API Gateway",
      "description": "APISIX Gateway Client for Mule APIs",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MULE_GATEWAY_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600",
        "client.secret.creation.time": "1735689600"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
