    {
      "clientId": "dashboards",
      "name": "OpenSearch Dashboards OIDC Client",
      "description": "OpenSearch Dashboards OpenSearch OIDC Client for SSO",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DASHBOARDS_OIDC_CLIENT_SECRET}",
      "redirectUris": [
        "https://localhost:9443/dashboards/auth/openid/login"
