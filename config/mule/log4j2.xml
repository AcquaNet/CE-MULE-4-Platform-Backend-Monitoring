<?xml version="1.0" encoding="utf-8"?>
<Configuration>

    <!--These are some of the loggers you can enable.
        There are several more you can find in the documentation.
        Besides this log4j configuration, you can also use Java VM environment variables
        to enable other logs like network (-Djavax.net.debug=ssl or all) and
        Garbage Collector (-XX:+PrintGC). These will be append to the console, so you will
        see them in the mule_ee.log file. -->

    <Properties>
        <Property name="mule.app.name">demo-opensearch</Property>
        <Property name="mule.env">dev</Property>
        <!-- log ingestion (Fluent Bit). Docker: defaults. CloudHub: set logs.host / logs.port / logs.token as
             application properties (they become system properties): the gateway host, 9100, LOG_INGEST_TOKEN -->
        <Property name="logs.host">${sys:logs.host:-log-ingest}</Property>
        <Property name="logs.port">${sys:logs.port:-5000}</Property>
        <Property name="logs.token">${sys:logs.token:-${env:LOG_INGEST_TOKEN:-no-token}}</Property>
    </Properties>

    <Appenders>
        <RollingFile name="file" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}demo-opensearch.log"
                 filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}demo-opensearch-%i.log">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Socket Appender for log ingestion (JSON over TCP to Fluent Bit) -->
        <Socket name="logs"
                host="${logs.host}"
                port="${logs.port}"
                protocol="TCP"
                reconnectionDelayMillis="5000">
            <JsonLayout compact="true" eventEol="true" properties="true">
                <KeyValuePair key="auth_token" value="${logs.token}"/>
                <!-- $$: resolved per event (a single $ is resolved once at startup) -->
                <KeyValuePair key="tenant_id" value="$${ctx:tenant_id:-unknown}"/>
                <KeyValuePair key="application" value="${mule.app.name}"/>
                <KeyValuePair key="environment" value="${mule.env}"/>
                <KeyValuePair key="log_type" value="mule"/>
            </JsonLayout>
        </Socket>

        <!-- Async Appender wrapping the log ingestion socket for better performance -->
        <Async name="AsyncLogs" includeLocation="true">
            <AppenderRef ref="logs"/>
        </Async>
    </Appenders>

    <Loggers>
        <!-- Http Logger shows wire traffic on DEBUG -->
        <!--AsyncLogger name="org.mule.service.http.impl.service.HttpMessageLogger" level="DEBUG"/-->
        <AsyncLogger name="org.mule.service.http" level="WARN"/>
        <AsyncLogger name="org.mule.extension.http" level="WARN"/>

        <!-- Mule logger -->
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
            <AppenderRef ref="AsyncLogs"/>
        </AsyncRoot>
    </Loggers>

</Configuration>
