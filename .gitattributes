# Files read inside Linux containers must keep LF, even on a Windows clone with core.autocrlf=true
# (a CRLF entrypoint fails with "bad interpreter", a CRLF apisix.yaml breaks start.sh's rendering).
*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.json        text eol=lf
*.properties  text eol=lf
*.xml         text eol=lf
*.html        text eol=lf
Dockerfile    text eol=lf
.env*         text eol=lf
*.bat         text eol=crlf
*.ps1         text eol=crlf
*.tar         binary
*.jar         binary
