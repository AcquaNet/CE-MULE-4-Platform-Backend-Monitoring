# =============================================================================
# OpenSearch Stack Environment Configuration
# =============================================================================
#
# IMPORTANT: This is a template file. Copy this file to .env and set actual values.
#
# DO NOT commit .env to version control!
# DO NOT use these example values in production!
#
# To generate secure random passwords, run:
#   ./config/scripts/setup/generate-secrets.sh   (install.sh runs it)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Platform parts (docker compose profiles). APISIX + Runtime Manager (+ its Mule workers) always run.
# Lite examples:  COMPOSE_PROFILES=                   (gateway + Runtime Manager + its Mule workers)
#                 COMPOSE_PROFILES=db,mq
# Leaving out `auth` (Keycloak)? Also set GATEWAY_AUTH=off or /api/* rejects every call.
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=db,mq,logging,tracing,monitoring,auth
GATEWAY_AUTH=on

# -----------------------------------------------------------------------------
# Mule platform (mule/docker-compose.yml)
# -----------------------------------------------------------------------------
# Mule CE runtime, downloaded at image build time (no tarballs in the repo).
#   MULE_VERSION: a CE version (4.12.0, 4.9.0, ...) or `latest` (newest CE release; the next
#   `docker compose build` picks up new releases). MULE_JAVA_VERSION must match the runtime:
#   4.4 -> 8 or 11, 4.5-4.8 -> 8/11/17, 4.9+ -> 17. Apps must support that Java too.
MULE_VERSION=4.12.0
MULE_JAVA_VERSION=17
mule_env=local-docker

# App the Runtime Manager deploys to all workers on first start and keeps updated
# (version: fixed, RELEASE, LATEST or x-SNAPSHOT)
MULEAPP_GROUP_ID=com.acqua
MULEAPP_ARTIFACT_ID=ce-mule-base
MULEAPP_VERSION=RELEASE

# Artifactory credentials, used by mule/maven-settings.xml (${env.ARTIFACTORY_USER} / ${env.ARTIFACTORY_PASSWORD})
ARTIFACTORY_USER=acqua-dev
ARTIFACTORY_PASSWORD=

# Artifact repository (tried before the repos in mule/maven-settings.xml)
ATINA_REPOSITORY_PROTOCOL=https
ATINA_REPOSITORY_URL=https://jfrog.atina-connection.com/artifactory/libs-release

# Runtime Manager - https://localhost:9443/runtime-manager/ (through APISIX, no published port)
RM_USER=admin
RM_PASSWORD=CHANGE_ME_PLEASE
# Keycloak client secret of the runtime-manager client (UI sign-in; realm role RM_OIDC_ROLE, default admin)
RM_OIDC_CLIENT_SECRET=CHANGE_ME_PLEASE
RM_OIDC_ROLE=admin
# Encrypts secure app properties at rest (losing it means re-entering them)
RM_SECRETS_KEY=CHANGE_ME_PLEASE
# Seconds between Maven update checks (0 = only on startup and via the Check button)
RM_MAVEN_POLL_SECONDS=300

# ActiveMQ (profile mq)
versionApacheMQ=5.19.11
MULE_MQ_WEB_CONSOL_PORT=8161
MULE_MQ_AMQP_PORT=5672
MULE_MQ_OPENWIRE_PORT=61616
# ActiveMQ web console password (user admin)
ACTIVEMQ_ADMIN_PASSWORD=CHANGE_ME_PLEASE

# MySQL (profile db)
MYSQL_ROOT_PASSWORD=CHANGE_ME_PLEASE
MYSQL_DATABASE=ce_backend_db
MYSQL_USER=ce_user
MYSQL_PASSWORD=CHANGE_ME_PLEASE
MYSQL_EXTERNAL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_FILE_CONFIG=/etc/mysql/conf.d
MYSQL_DATA=/var/lib/mysql

# -----------------------------------------------------------------------------
# OpenSearch Configuration
# Includes FREE Document-Level Security for multi-tenancy!
# -----------------------------------------------------------------------------

# OpenSearch version
OPENSEARCH_VERSION=2.19.7

# OpenSearch admin password (generate-secrets.sh fills it; must be strong, OpenSearch rejects weak ones).
# Applied only when the security index is first created: to change it, wipe the opensearch-data volume.
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_PLEASE

# OpenSearch cluster name
OPENSEARCH_CLUSTER_NAME=opensearch-cluster

# OpenSearch node name
NODE_NAME=opensearch

# Discovery type (single-node for standalone, multi-node for cluster)
DISCOVERY_TYPE=single-node

# OpenSearch heap size (50% of available RAM, max 32GB)
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# -----------------------------------------------------------------------------
# Jaeger Configuration (Distributed Tracing)
# Receives traces via OpenTelemetry from Mule applications
# -----------------------------------------------------------------------------

# Jaeger version
JAEGER_VERSION=2.22.0

# -----------------------------------------------------------------------------
# Log + trace ingestion (also from CloudHub, through APISIX)
# -----------------------------------------------------------------------------

# Every log event sent to Fluent Bit (log-ingest:5000 inside, localhost:9100 via APISIX) must carry
# auth_token = this value (the Mule log4j Socket appender adds it), or it is dropped.
LOG_INGEST_TOKEN=CHANGE_ME_PLEASE

# OTLP traces via APISIX https://<gateway>:9443/otlp/v1/traces need header x-otlp-token: <this value>
# (OTEL_EXPORTER_OTLP_HEADERS=x-otlp-token=...). Workers inside the network use jaeger:4317 directly.
# Extra names/IPs for the gateway certificate, comma-separated: the platform's address as other servers
# (Runtime Manager worker nodes, CloudHub with a public cert aside) reach it. Changing it re-issues the cert.
GATEWAY_HOSTNAMES=

OTLP_INGEST_TOKEN=CHANGE_ME_PLEASE

# -----------------------------------------------------------------------------
# APISIX Configuration
# -----------------------------------------------------------------------------

# APISIX runs in standalone mode: routes live in config/apisix/apisix.yaml
# (no Admin API, no admin key, no etcd).

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------

# Grafana admin user password
# Minimum 8 characters
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_PLEASE

# Grafana secret key (for signing cookies and data sources)
# Generate with: openssl rand -base64 32
GRAFANA_SECRET_KEY=CHANGE_ME_PLEASE

# -----------------------------------------------------------------------------
# Client/Deployment Information
# -----------------------------------------------------------------------------

# Client name (used for tenant identification and resource tagging)
CLIENT_NAME=default-client

# Deployment environment
# Values: development, staging, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------

# APISIX serves HTTPS on 9443 with certs/apisix (local CA, created on first start). Its names: GATEWAY_HOSTNAMES
# (config/scripts/setup/generate-certs.sh --domain); a public cert: config/scripts/setup/setup-letsencrypt.sh.

# -----------------------------------------------------------------------------
# Multi-Tenancy Configuration
# -----------------------------------------------------------------------------
# Document-Level Security (DLS) enables tenant isolation in OpenSearch.
# Each tenant can only view logs containing their specific tenant_id.

# Keycloak (realm import + config/scripts/tenants/manage-tenants.sh)
KEYCLOAK_REALM=mule
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_PLEASE
# seeded realm users admin (Runtime Manager admin role) and developer; applied on realm import (empty Keycloak DB)
KEYCLOAK_REALM_ADMIN_PASSWORD=CHANGE_ME_PLEASE
KEYCLOAK_REALM_DEV_PASSWORD=CHANGE_ME_PLEASE
# client secret of mule-api-gateway (Keycloak realm + APISIX openid-connect)
MULE_GATEWAY_CLIENT_SECRET=CHANGE_ME_PLEASE
# client secret of the Keycloak dashboards client (OpenSearch Dashboards SSO) and its session cookie key (32+ chars)
DASHBOARDS_OIDC_CLIENT_SECRET=CHANGE_ME_PLEASE
DASHBOARDS_COOKIE_SECRET=CHANGE_ME_PLEASE
# single sign-on (home page https://localhost:9443/, Jaeger, Prometheus, ActiveMQ): Keycloak client gateway-sso
# and the key of APISIX's session cookie; Grafana signs in with client grafana
GATEWAY_SSO_CLIENT_SECRET=CHANGE_ME_PLEASE
GATEWAY_SESSION_SECRET=CHANGE_ME_PLEASE
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME_PLEASE
# Keycloak's Postgres (reachable from every container on the networks)
KEYCLOAK_DB_PASSWORD=CHANGE_ME_PLEASE
# basic-auth password of the gateway user ops (/jaeger, /prometheus, /activemq), used only with GATEWAY_AUTH=off
GATEWAY_OPS_PASSWORD=CHANGE_ME_PLEASE

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------

# Enable automated backups (true/false)
BACKUP_ENABLED=true

# Backup schedule (cron expression)
# Examples:
#   0 2 * * *        = Daily at 2:00 AM
#   0 */6 * * *      = Every 6 hours
BACKUP_SCHEDULE="0 2 * * *"

# Snapshot repository type
# Options: fs (filesystem), s3 (AWS S3), azure (Azure Blob), gcs (Google Cloud Storage)
BACKUP_REPOSITORY_TYPE=fs

# Snapshot repository name (shown in OpenSearch)
BACKUP_REPOSITORY_NAME=backup-repo

# Filesystem snapshots go to /usr/share/opensearch/data/snapshots (inside the opensearch-data volume)

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# Maximum number of snapshots to retain
BACKUP_MAX_COUNT=30

# Compress snapshots (true/false)
BACKUP_COMPRESS=true

# Backup mode (what indices to include)
# Options: daily, *, mule-logs-*, etc.
BACKUP_INDICES=daily

# -----------------------------------------------------------------------------
# Log/trace retention (service log-archiver; applied on `docker compose up -d`)
# -----------------------------------------------------------------------------

# Log indices (mule-logs-*, logstash-*) are archived to ./volumes/log-archive/<index>.ndjson.gz, then deleted
# after this many days...
LOGS_RETENTION_DAYS=365
# ...or earlier, oldest first, while OpenSearch's disk is fuller than this (OpenSearch stops writing at 95%)
LOGS_DISK_MAX_PERCENT=80

# Jaeger trace indices (jaeger-span-*, jaeger-service-*): deleted after this many days, not archived
JAEGER_RETENTION_DAYS=30

# Seconds between retention passes
LOG_ARCHIVE_INTERVAL=300

# Optional: upload archives to S3 (local copy removed once uploaded). Empty bucket = local archive only.
# ENDPOINT only for S3-compatible stores (MinIO, ...): e.g. http://minio:9000 (path-style); empty = AWS
LOG_ARCHIVE_S3_BUCKET=
LOG_ARCHIVE_S3_REGION=us-east-1
LOG_ARCHIVE_S3_ENDPOINT=
LOG_ARCHIVE_S3_PREFIX=log-archive
LOG_ARCHIVE_S3_ACCESS_KEY=
LOG_ARCHIVE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Monitoring and Alerting Configuration
# -----------------------------------------------------------------------------
# Monitoring and alerting (profiles monitoring / alerting / opensearch-monitoring)
# -----------------------------------------------------------------------------

# Prometheus Configuration
PROMETHEUS_RETENTION=30d

# Email alerts: config/scripts/monitoring/setup-monitoring.sh renders them into alertmanager.yml
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alerts@example.com
SMTP_USE_TLS=true

# Alertmanager Configuration
ALERTMANAGER_RETENTION=120h
ALERTMANAGER_EXTERNAL_URL=https://localhost:9443/alertmanager   # keep the /alertmanager path (gateway route, Prometheus)

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# ./install.sh creates .env from this file with generated secrets (config/scripts/setup/generate-secrets.sh)
# and keeps it at chmod 600. Never commit .env. Values with spaces must be quoted (scripts source this file).
